# OdooInfrastructure - environment template
# Copy to .env (same folder as docker-compose.traefik.yml) and set real values.
# NEVER commit .env.

# ----- Public domains (DNS must point to Traefik host) -----
DOMAIN_ROOT=devops-odoo.com
ODOO17_DOMAIN=odoo17.devops-odoo.com
ODOO19_DOMAIN=odoo19.devops-odoo.com
# Optional future services (documented; compose files not included unless added)
PORTAINER_DOMAIN=portainer.devops-odoo.com
PGADMIN_DOMAIN=pgadmin.devops-odoo.com

# ----- Traefik / TLS -----
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
# Must match Traefik certificate resolver name (this stack uses: le)
CERTSRESOLVER=le
# Cloudflare API token for DNS challenge (required when using DNS challenge)
CF_DNS_API_TOKEN=replace-with-cloudflare-dns-api-token
# ACME account email
LETSENCRYPT_EMAIL=admin@devops-odoo.com

# ----- Odoo 17 (from detected project style: odoo:17 + postgres:16) -----
ODOO17_IMAGE=odoo:17
PG17_IMAGE=postgres:16
ODOO17_DB_USER=odoo17
ODOO17_DB_PASSWORD=replace-with-strong-password
ODOO17_DB_NAME=postgre
ODOO17_ADMIN_PASSWORD=replace-with-strong-master-password

# ----- Odoo 19 (from detected project style: odoo:19 + postgres:18) -----
ODOO19_IMAGE=odoo:19
PG19_IMAGE=postgres:18
ODOO19_DB_USER=odoo19
ODOO19_DB_PASSWORD=replace-with-strong-password
ODOO19_DB_NAME=postgre
ODOO19_ADMIN_PASSWORD=replace-with-strong-master-password

# ----- Safety -----
# Odoo HTTP/chat ports are NOT published in Traefik mode. Traefik exposes 80/443 only.
# PostgreSQL ports are NEVER published.
