# Odoo 19 - Traefik integration (hide ports, use HTTPS domain)
# Copy relevant values into your Odoo 19 project .env, then run:
#   docker compose -f docker-compose.traefik.yml up -d

ODOO_IMAGE=odoo:19
PG_IMAGE=postgres:18
POSTGRES_USER=odoo19
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgre
ODOO_ADMIN_PASSWORD=CHANGE_ME_STRONG_MASTER_PASSWORD

# Traefik routing (no host ports published in docker-compose.traefik.yml)
ODOO_DOMAIN=odoo19.devops-odoo.com
DOCKER_PROXY_NETWORK=proxy
# Must match Traefik certificates resolver name (this repo's Traefik uses: le)
CERTSRESOLVER=le

# Internal naming (keep unique per instance)
ODOO_NETWORK=odoo19_internal
ODOO_CONTAINER_NAME=odoo19
ODOO_DB_CONTAINER_NAME=odoo19-db
